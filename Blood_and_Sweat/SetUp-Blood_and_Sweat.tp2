BACKUP ~backup/Blood_and_Sweat~
AUTHOR ~Grammarsalad~
//README ~Blood_and_Sweat\Blood_and_Sweat_README.pdf~

VERSION ~1.00.00~


ALWAYS

    OUTER_SPRINT ~folder~ ~Blood_and_Sweat~ // Replace "Mod_Name" with the actual mod folder name. 

 	ACTION_IF GAME_IS ~bg2ee eet~ THEN BEGIN
          OUTER_SPRINT ~game~ ~bg2ee~
    END

 	ACTION_IF GAME_IS ~bgee~ THEN BEGIN
          OUTER_SPRINT ~game~ ~bgee~
    END

 	ACTION_IF GAME_IS ~iwdee~ THEN BEGIN
          OUTER_SPRINT ~game~ ~iwdee~
    END

 	ACTION_IF GAME_IS ~bg2 bgt~ THEN BEGIN
          OUTER_SPRINT ~game~ ~bg~
          OUTER_SPRINT ~style~ ~vanilla_style~
    END

 	ACTION_IF GAME_IS ~bg~ THEN BEGIN
          OUTER_SPRINT ~game~ ~no~
          OUTER_SPRINT ~style~ ~no_style~
    END

 	ACTION_IF GAME_IS ~bgee bg2ee eet~ THEN BEGIN
          OUTER_SPRINT ~style~ ~bgee_style~
    END

 	ACTION_IF GAME_IS ~iwdee~ THEN BEGIN
          OUTER_SPRINT ~style~ ~iwdee_style~
    END

    INCLUDE ~Blood_and_Sweat/Blood_and_Sweat_settings.ini~

    INCLUDE ~Blood_and_Sweat/lib/variables.ini~

    INCLUDE ~Blood_and_Sweat/lib/item_casting.tpa~

    INCLUDE ~Blood_and_Sweat/lib/snm_functions.tpa~

    INCLUDE ~Blood_and_Sweat/lib/lib.tpa~  //morph's hla functions

    INCLUDE ~Blood_and_Sweat/lib/hla_actions.tpa~  //SD's hla functions

    INCLUDE ~Blood_and_Sweat/lib/add_headers.tpa~

    INCLUDE ~Blood_and_Sweat/lib/add_spell_ex.tpa~

    INCLUDE ~Blood_and_Sweat/lib/effect_return.tpa~

    INCLUDE ~Blood_and_Sweat/lib/add_sumtable.tpa~

    INCLUDE ~Blood_and_Sweat/lib/SEQUENCER_MENU.tpa~

    INCLUDE ~Blood_and_Sweat/lib/alter_effect.tpa~

    INCLUDE ~Blood_and_Sweat/lib/remove_lines.tpa~

    INCLUDE ~Blood_and_Sweat/lib/summon_table.tpa~

    INCLUDE ~Blood_and_Sweat/lib/splprot_attributes.tpa~

    INCLUDE ~Blood_and_Sweat/lib/spell_to_innate.tpa~

    INCLUDE ~Blood_and_Sweat/lib/spell_clone_effects.tpa~

    INCLUDE ~Blood_and_Sweat/lib/bg2fp_effect_batches_fnp.tpa~

    INCLUDE ~Blood_and_Sweat/lib/bg2fp_effect_batches_b_vise.tpa~

    INCLUDE ~Blood_and_Sweat/lib/bg2fp_effect_batches_spell_saves.tpa~

    INCLUDE ~Blood_and_Sweat/lib/extra_alter_effect.tpa~

    INCLUDE ~Blood_and_Sweat/lib/scroll_placement.tpa~

END

//Below from IWDification. Looks like a way to check spell.ids for particular spells...
//ACTION_IF (!FILE_CONTAINS_EVALUATED(~spell.ids~ ~WIZARD_SNILLOCS_SNOWBALL_SWARM~) OR override_arcane) BEGIN

//need to keep my options open

ASK_EVERY_COMPONENT

/* Language Settings */
AUTO_TRA ~Blood_and_Sweat/tra/%s~
LANGUAGE ~English~ ~english~
         ~Blood_and_Sweat/tra/english/setup.tra~
//       ~Blood_and_Sweat/tra/english/new_spells.tra~  //for new spells
//       ~Blood_and_Sweat/tra/english/IWD_spells.tra~  //for IWDEE spells
//       ~Blood_and_Sweat/tra/english/enchant_items.tra~
//       ~Blood_and_Sweat/tra/english/cantrips.tra~  //for cantrips
//       ~Blood_and_Sweat/tra/english/revised.tra~  //for revised
//       ~Blood_and_Sweat/tra/english/items.tra~  //for items
//       ~Blood_and_Sweat/tra/english/icons.tra~   //icons





